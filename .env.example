# =============================================================================
# APPLICATION URLS & SETTINGS
# =============================================================================
NEXT_PUBLIC_APP_URL="https://jhumkajunction.vercel.app"
NEXT_PUBLIC_APP_NAME="Jhumka Junction"
ADMIN_EMAIL="admin@jhumkajunction.com"

# =============================================================================
# DATABASE (PostgreSQL / Supabase / Neon)
# =============================================================================
# Transaction Pooler URL (e.g. Supabase port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct connection (port 5432) for migrations
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# =============================================================================
# SUPABASE API (Optional - for Storage/Auth)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# =============================================================================
# AUTHENTICATION (NextAuth.js & Google OAuth)
# =============================================================================
NEXTAUTH_URL="https://jhumkajunction.vercel.app"
NEXTAUTH_SECRET="7a8f3b9c2e1d4e6f8a0b2c4d6e8f0a2b4c6d8e0f2a4b6c8d0e2f4a6b8c0d2e4f"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# PAYMENTS (Razorpay & UPI)
# =============================================================================
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"

# Optional: Stripe (fallback)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# TRANSACTIONAL EMAILS (Resend)
# =============================================================================
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="orders@jhumkajunction.com"
